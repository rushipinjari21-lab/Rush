# Copy to deploy/.env on the production server. Do not commit the real file.
DB_NAME=pcmc_billpro
DB_USER=pcmc_app
DB_PASSWORD=replace-with-a-long-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-unique-password

PORT=5000
DB_CONNECTION_LIMIT=10
DATABASE_RETRY_MS=5000
DATABASE_HEALTH_CHECK_MS=10000
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_REFRESH_EXPIRES_IN=7d
MAX_FILE_SIZE=26214400
UPLOAD_PATH=/app/uploads
LOG_LEVEL=info

# Set this to the final website domain. The two local origins let the native
# Capacitor apps call the API after they have been configured with its HTTPS URL.
CORS_ORIGIN=https://billing.example.com,http://localhost,capacitor://localhost
