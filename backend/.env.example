# ==========================================================
# PCMC BillPro - Backend Environment Configuration (.env.example)
# ==========================================================
NODE_ENV=development
PORT=5000

# Central MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pcmc_billpro
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=20

# Local XAMPP Recovery (Windows Dev Only - set to false on Linux VPS)
AUTO_START_MYSQL=true
MYSQLD_PATH=C:/xampp/mysql/bin/mysqld.exe
MYSQL_INI_PATH=C:/xampp/mysql/bin/my.ini
DATABASE_RETRY_MS=5000
DATABASE_HEALTH_CHECK_MS=10000

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace_with_another_secure_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# File & Document Storage
MAX_FILE_SIZE=26214400
UPLOAD_PATH=./uploads

# CORS Allowed Origins (Comma-separated for multiple domains)
# e.g., https://billing.pcmc.gov.in,https://app.pcmc.gov.in
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Logging
LOG_LEVEL=info

# Google Gemini AI (Schedule-B BOQ Parser & Site Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
